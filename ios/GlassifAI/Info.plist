<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>AutoLoom</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>AutoLoom Media Glasses</string>
	<key>AutoLoomCommitSHA</key>
	<string>$(AUTOLOOM_COMMIT_SHA)</string>
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>AutoLoom Media Glasses</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Auto Loom</string>
		</dict>
	</array>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>glassifai</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Begin required section for Device Access Toolkit Apps -->
	<!-- Meta Wearables Device Access Toolkit Setup -->
	<key>MWDAT</key>
	<dict>
		<key>AppLinkURLScheme</key>
		<!-- Tell DAT your URL scheme so it can be called back from Meta AI -->
		<string>glassifai://</string>
		<key>MetaAppID</key>
		<!-- Without Developer Mode, this key will need to be set with ID from the app registered in Wearables Developer Center -->
		<string>$(META_APP_ID)</string>
		<!-- Without Developer Mode, this key will need to be set with ClientToken from the app registered in Wearables Developer Center -->
		<key>ClientToken</key>
		<string>$(CLIENT_TOKEN)</string>
		<!-- Without Developer Mode, this key will need to be set with your Apple Developer Team ID - Set this in Xcode under Signing & Capabilities -->
		<key>TeamID</key>
		<string>$(DEVELOPMENT_TEAM)</string>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>external-accessory</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>AutoLoom Media Glasses uses Bluetooth to receive camera frames from your Meta glasses.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>AutoLoom Media Glasses uses the glasses connection while you ask about what you see.</string>
	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.meta.ar.wearable</string>
	</array>
	<!-- End required section for Device Access Toolkit Apps -->
	<key>NSCameraUsageDescription</key>
	<string>AutoLoom Media Glasses uses the iPhone camera, only when you choose it, so the assistant can answer questions about what you see.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>AutoLoom Media Glasses uses the microphone for your live voice conversation with the assistant.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Lets your iPhone find and stream from your Meta glasses over Wi-Fi, and reach your own agent gateway (OpenClaw) if you connect one.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_bonjour._tcp</string>
	</array>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Only when you turn on the wake phrase: on-device speech recognition listens for your phrase (while the app is open, or in the background if you turn on Hands-Free Ready) to start a conversation. Audio is not stored or sent.</string>
	<key>NSContactsUsageDescription</key>
	<string>Only when you ask to call, message or look up someone by name: AutoLoom Media Glasses finds that contact's phone number on this iPhone. Contacts are not uploaded.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Only if you turn on "Attach the place" for visual memories: the current place is saved with that memory on this iPhone.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>AutoLoom Media Glasses adds reminders you ask for and reads your open reminders when you ask about them.</string>
	<key>NSRemindersUsageDescription</key>
	<string>AutoLoom Media Glasses adds reminders you ask for and reads your open reminders when you ask about them.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>AutoLoom Media Glasses reads your calendar when you ask about today or upcoming events, and adds events you ask for.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>AutoLoom Media Glasses adds calendar events you ask for.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>AutoLoom Media Glasses reads your calendar when you ask about today or upcoming events, and adds events you ask for.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchMark</string>
	</dict>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
